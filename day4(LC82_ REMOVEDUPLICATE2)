// RIGHGT APPROACH BBY GPT 
class Solution {
public:
    ListNode* deleteDuplicates(ListNode* head) {

        // Step 1: Create a dummy node
        ListNode* dummy = new ListNode(-1);
        dummy->next = head;

        // Step 2: Initialize pointers
        ListNode* prev = dummy;
        ListNode* current = head;

        while (current != NULL) {

            // Check if current node is the start of a duplicate block
            if (current->next != NULL &&
                current->val == current->next->val) {

                int duplicateValue = current->val;

                // Skip all nodes having duplicateValue
                while (current != NULL &&
                       current->val == duplicateValue) {

                    current = current->next;
                }

                // Connect previous unique node to next unique node
                prev->next = current;
            }
            else {

                // Current node is unique
                prev = current;
                current = current->next;
            }
        }

        return dummy->next;
    }
};
